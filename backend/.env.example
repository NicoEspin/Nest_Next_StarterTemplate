NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://fullstack:replace-with-your-local-password@localhost:5433/fullstack?schema=public"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
POSTGRES_USER=fullstack
POSTGRES_DB=fullstack
POSTGRES_PASSWORD=replace-with-your-local-password
# Optional, only for the explicit one-time bootstrap; never committed or logged.
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
